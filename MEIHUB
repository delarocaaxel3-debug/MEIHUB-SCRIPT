local function Slider(parent,text,min,max,default,callback)
	local holder=New("Frame",{Size=UDim2.new(1,-5,0,55),BackgroundColor3=Theme.Panel},parent)
	Round(holder,7)
	New("TextLabel",{Position=UDim2.fromOffset(10,3),Size=UDim2.new(1,-70,0,22),BackgroundTransparency=1,Text=text,TextColor3=Theme.Text,TextSize=12,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left},holder)
	local valueLabel=New("TextLabel",{Position=UDim2.new(1,-60,0,3),Size=UDim2.fromOffset(50,20),BackgroundTransparency=1,Text=tostring(default),TextColor3=Theme.Accent,TextSize=11,Font=Enum.Font.GothamBold},holder)
	local bar=New("Frame",{Position=UDim2.fromOffset(10,32),Size=UDim2.new(1,-20,0,7),BackgroundColor3=Color3.fromRGB(70,70,75)},holder)
	Round(bar,5)
	local fill=New("Frame",{Size=UDim2.new((default-min)/(max-min),0,1,0),BackgroundColor3=Theme.Accent},bar)
	Round(fill,5)
	local dragging=false
	local function Update(x)
		local percent=math.clamp((x-bar.AbsolutePosition.X)/math.max(bar.AbsoluteSize.X,1),0,1)
		local value=math.floor(min+(max-min)*percent+.5)
		fill.Size=UDim2.new(percent,0,1,0); valueLabel.Text=tostring(value)
		if callback then callback(value) end
	end
	bar.InputBegan:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=true; Update(input.Position.X) end
	end)
	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then Update(input.Position.X) end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end
	end)
end

