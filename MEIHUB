local trackedHumans={}
local function TrackHumanoid(h)
	if not h or trackedHumans[h] then return end
	trackedHumans[h]=true
	local lastHealth=h.Health
	h.HealthChanged:Connect(function(newHealth)
		local delta=lastHealth-newHealth
		if delta>0 then
			SessionDamage=SessionDamage+delta
			SessionHits=SessionHits+1
			DPSDamage=DPSDamage+delta
			DamageText.Text="Damage: "..math.floor(SessionDamage)
			HitText.Text="Hits: "..SessionHits
		end
		lastHealth=newHealth
	end)
	h.AncestryChanged:Connect(function()
		if not h:IsDescendantOf(game) then trackedHumans[h]=nil end
	end)
end

local function ScanHumans()
	local myChar = LocalPlayer.Character
	local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
	for _,obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Humanoid") and obj ~= myHum then
			TrackHumanoid(obj)
		end
	end
end

task.spawn(function()
	while true do
		task.wait(1)
		pcall(ScanHumans)
		local elapsed=os.clock()-DPSWindowStart
		if elapsed>=1 then
			DPSText.Text="DPS: "..math.floor(DPSDamage/elapsed)
			DPSDamage=0
			DPSWindowStart=os.clock()
		end
	end
end)

