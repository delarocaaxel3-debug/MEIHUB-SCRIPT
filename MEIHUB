local function UnlockMenu()
	KeyGui.Enabled=false
	Gui.Enabled=true
	FloatGui.Enabled=Config.ShowFloatingIcon
	ShowPage("MAIN")
end

local function TryUnlock()
	if string.upper(KeyBox.Text)==KEY then
		UnlockMenu()
	else
		KeyBox.Text=""
		KeyBox.PlaceholderText="WRONG KEY"
	end
end

Unlock.MouseButton1Click:Connect(TryUnlock)
KeyBox.FocusLost:Connect(function(enterPressed) if enterPressed then TryUnlock() end end)

